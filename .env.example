# Copy to .env. No paid API keys are needed; there is no cloud LLM setting.
# ENV=production refuses to start with AUTH_ENABLED=false or a default pepper, and hides /docs.
ENV=development
DATABASE_URL=postgresql+psycopg://qc_app:qc_app_dev@localhost:5432/qc_rca
READONLY_DATABASE_URL=postgresql+psycopg://qc_readonly:qc_readonly_dev@localhost:5432/qc_rca
DB_STATEMENT_TIMEOUT_MS=5000

# Local models (Ollama). Set LLM_ENABLED=false to run fully deterministic.
OLLAMA_BASE_URL=http://localhost:11434
LLM_ENABLED=true
LLM_MODEL=qwen2.5:1.5b
LLM_TIMEOUT_S=45
LLM_NARRATIVE_ENABLED=false
EMBEDDING_MODEL=all-minilm
EMBEDDING_DIM=384

# Security: generate with `python -c "import secrets;print(secrets.token_urlsafe(32))"`
API_KEY_PEPPER=change-me
AUTH_ENABLED=true
RATE_LIMIT_PER_MINUTE=20
CORS_ORIGINS=["http://localhost:5173"]
CHECKPOINT_ENABLED=true

# Retention in days (0 = keep forever); purged at startup and every RETENTION_INTERVAL_HOURS
INVESTIGATION_RETENTION_DAYS=30
AUDIT_RETENTION_DAYS=90
RETENTION_INTERVAL_HOURS=6
